{
  "expo": {
    "name": "Presenti",
    "slug": "MOBILE-APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presenti",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.attendance.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Presenti requires your location to verify physical presence on premises for attendance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Presenti requires your location to verify physical presence on premises for attendance."
      }
    },
    "android": {
      "package": "com.attendance.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "NEARBY_WIFI_DEVICES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#162447",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#162447",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Presenti to verify physical presence on premises for attendance.",
          "locationWhenInUsePermission": "Allow Presenti to verify physical presence on premises for attendance."
        }
      ],
      "react-native-wifi-reborn"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63af994d-a295-4da6-bcc3-011e03a9fb4e"
      }
    }
  }
}
