# EAS Ignore File
# When present, EAS Build uses this file INSTEAD of .gitignore.
# We omit google-services.json so EAS can upload it, while keeping it out of GitHub via .gitignore.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Environment secrets
.env
.env.local
.env.*.local
